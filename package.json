{
  "name": "sana-panel-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:stage": "vite --mode staging",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --mode development",
    "build:stage": "tsc -b && vite build --mode staging",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "orval",
    "api:unused": "node scripts/openapi/unused.mjs",
    "api:diff": "node scripts/openapi/diff.mjs",
    "api:check": "orval && git diff --exit-code -- src/api/generated",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tanstack/react-query": "^5.104.3",
    "antd": "^6.6.6",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jalaali-js": "^2.0.1",
    "js-cookie": "^3.0.8",
    "react": "^19.3.1",
    "react-date-object": "^2.1.9",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-multi-date-picker": "^4.5.2",
    "react-router": "^8.4.0",
    "react-to-print": "^3.3.0",
    "sonner": "^2.0.8",
    "vazirmatn": "^33.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/file-saver": "^2.0.7",
    "@types/jalaali-js": "^1.2.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "msw": "^3.0.3",
    "orval": "^8.43.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
